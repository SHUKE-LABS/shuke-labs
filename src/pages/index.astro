---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { visiblePosts } from '../lib/blog';

const products = (await getCollection('products')).sort(
  (a, b) => a.data.weight - b.data.weight,
);
const devTools = products.filter((p) => p.data.group === 'dev');
const apps = products.filter((p) => p.data.group === 'app');

// Latest-writing teaser: the 3 newest posts across all projects, newest first.
const latestPosts = visiblePosts(await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const cloudFeatures = [
  {
    heading: 'Browser onboarding',
    body: 'A first-run wizard instead of a terminal session: GitHub sign-in, credential provisioning, license activation, and an environment check before anything runs.',
  },
  {
    heading: 'Fleet dashboard',
    body: 'A sessions rail with per-role transcripts, and pause/resume/stop/restart controls for every agent session.',
  },
  {
    heading: 'Repository management',
    body: 'Add the repositories the fleet works on from a page — discovery through your GitHub installations, no git cloning by hand.',
  },
  {
    heading: 'Hosted runtime',
    body: 'The agents run on our infrastructure. No tmux, no VM to keep alive — the same delivery pipeline, without operating it yourself.',
  },
];
---

<BaseLayout>
  <Nav />
  <main class="flex-1">
    <!-- Company hero -->
    <section class="mx-auto max-w-5xl px-6 pt-14 pb-16 sm:pb-20">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent">SHUKE LABS</p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight text-ink">
        Build more, struggle less.
      </h1>
      <p class="mt-5 max-w-2xl text-xl text-muted leading-relaxed">
        SHUKE Labs is a New Zealand software company. We build tools on one thesis: software
        should treat AI agents as teammates, not tools — and we ship what our own agents build.
      </p>
    </section>

    <!-- Lead product: My AI Team Cloud (hosted My AI Team, in development) -->
    <section id="cloud" class="border-y border-line bg-surface-soft">
      <div class="mx-auto max-w-5xl px-6 py-16">
        <div class="flex flex-wrap items-center gap-3">
          <h2 class="text-2xl sm:text-3xl font-bold text-ink">My AI Team Cloud</h2>
          <span class="rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold uppercase tracking-wide text-accent">
            In development
          </span>
        </div>
        <p class="mt-1 text-muted">Hosted My AI Team.</p>
        <p class="mt-4 max-w-2xl text-lg text-muted leading-relaxed">
          My AI Team turns your issue backlog into an async delivery pipeline: agents claim
          tickets, implement on a branch, open PRs, and merge them themselves while you set
          direction. My AI Team Cloud is the same fleet, hosted — no terminal, no VM to keep
          alive.
        </p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {
            cloudFeatures.map((f) => (
              <div class="rounded-xl border border-line bg-surface p-6">
                <h3 class="font-semibold text-ink">{f.heading}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{f.body}</p>
              </div>
            ))
          }
        </div>
        <p class="mt-8 text-sm text-muted">
          Available today as a self-hosted product:
          <a
            href="https://mat.shukelabs.com"
            class="font-medium text-accent hover:text-accent-hover hover:underline underline-offset-2">mat.shukelabs.com &rarr;</a
          >
        </p>
      </div>
    </section>

    <!-- Product grid -->
    <section id="products" class="mx-auto max-w-5xl px-6 py-16 scroll-mt-20">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-muted">Developer tools</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {devTools.map((product) => <ProductCard product={product} />)}
        </div>
      </div>
      <div class="mt-12">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-muted">Apps</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {apps.map((product) => <ProductCard product={product} />)}
        </div>
      </div>
    </section>

    <!-- Latest writing -->
    {latestPosts.length > 0 && (
      <section class="mx-auto max-w-5xl px-6 pb-16">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-muted">Latest writing</h2>
          <a
            href="/blog"
            class="inline-flex items-center gap-1 text-sm font-medium text-accent hover:text-accent-hover"
          >
            Read the blog &rarr;
          </a>
        </div>
        <ul class="mt-4 divide-y divide-line border-t border-line">
          {latestPosts.map((post) => (
            <BlogCard post={post} heading="h3" />
          ))}
        </ul>
      </section>
    )}

    <!-- Closing CTA -->
    <section class="mx-auto max-w-5xl px-6 pb-24">
      <div class="rounded-2xl border border-line bg-surface-soft p-8 text-center sm:p-10">
        <h2 class="text-2xl font-bold text-ink">Build more, struggle less.</h2>
        <p class="mx-auto mt-2 max-w-xl text-muted">
          Browse what we build, follow the writing, and watch this space — the hosted product is
          on its way.
        </p>
        <a
          href="https://github.com/SHUKE-LABS"
          target="_blank"
          rel="noopener"
          class="mt-6 inline-flex items-center rounded-lg bg-accent px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-hover"
        >
          Explore on GitHub
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
