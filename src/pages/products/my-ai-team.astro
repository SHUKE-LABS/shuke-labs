---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { plans } from '../../config/pricing';

const title = 'My AI Team';
const description =
  'A fleet of AI agents that plan, build, review, and merge real code for solo builders and small teams.';
---

<BaseLayout title={title} description={description}>
  <Nav />
  <main class="flex-1">
    <!-- Hero -->
    <section class="mx-auto max-w-5xl px-6 pt-6 pb-12 sm:pt-8 sm:pb-16">
      <a href="/" aria-label="Back to home" class="text-sm text-muted hover:text-ink transition-colors">&larr;</a>
      <p class="mt-3 text-sm font-semibold uppercase tracking-wider text-muted">My AI Team</p>
      <div class="mt-2 grid items-center gap-6 sm:grid-cols-[minmax(0,1fr)_9rem]">
        <div>
          <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-ink">
            Ship real code while you sleep.
          </h1>
          <p class="mt-4 max-w-2xl text-xl sm:text-2xl font-medium text-accent">
            Plan, build, review, and merge your backlog with a fleet of AI agents.
          </p>
          <p class="mt-4 max-w-2xl text-lg text-muted leading-relaxed">
            Built for solo builders and small teams who want more shipped without losing the decisions behind the work.
          </p>
        </div>
        <div class="flex justify-start sm:justify-end">
          <img
            src="/images/my-ai-team-logo.svg"
            alt="My AI Team logo: an ideas list and three-agent delivery loop"
            width="144"
            height="144"
            class="h-28 w-28 sm:h-36 sm:w-36"
          />
        </div>
      </div>
    </section>

    <!-- Plans -->
    <section id="plans" class="mx-auto max-w-5xl px-6 pb-16">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-muted">Choose your plan</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {
          plans.map((plan) => (
            <div class="flex flex-col rounded-2xl border border-line bg-surface-soft p-6 sm:p-8">
              <span class="text-sm font-semibold uppercase tracking-wider text-accent">{plan.label}</span>
              <p class="mt-3">
                <span class="text-4xl font-bold text-ink">{plan.price}</span>
                <span class="ml-1 text-muted">{plan.period}</span>
              </p>
              <p class="mt-3 text-sm font-medium text-ink">Up to {plan.deviceLimit} devices</p>
              <p class="mt-2 text-sm text-muted">Annual access to My AI Team.</p>
              <a
                href={plan.checkoutUrl}
                class="mt-6 inline-flex items-center justify-center rounded-lg bg-accent px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-hover"
              >
                Choose {plan.label}
              </a>
            </div>
          ))
        }
      </div>
      <p class="mt-5 text-sm text-muted">
        Payments are handled securely by LemonSqueezy. The checkout page confirms the plan before purchase.
      </p>
    </section>

    <!-- How it works -->
    <section class="mx-auto max-w-5xl px-6 pb-16">
      <h2 class="text-2xl font-bold text-ink">How it works</h2>
      <img
        src="/images/my-ai-team-loop.svg"
        alt="Autonomous AI loop: a human kicks off with the Explorer agent; Planner, Reviewer, Developer and Auditor cycle tickets from plan to review to merge, then file new tickets that feed back to the Planner."
        width="740"
        height="605"
        class="mt-6 mx-auto block h-auto w-full"
      />
      <p class="mt-4 text-center text-sm">
        <a
          href="https://mat-docs.shukelabs.com"
          target="_blank"
          rel="noopener"
          class="text-accent hover:underline"
        >
          Read the documentation &rarr;
        </a>
      </p>
    </section>

  </main>
  <Footer />
</BaseLayout>
